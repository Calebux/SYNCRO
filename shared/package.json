{
  "name": "@syncro/shared",
  "version": "1.0.0",
  "description": "Shared domain models and types for SYNCRO",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "subscription-math": ["src/subscription-math.ts"],
      "security": ["src/security.ts"],
      "crypto": ["src/crypto/index.ts"],
      "*": ["src/*"]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./subscription-math": {
      "types": "./src/subscription-math.ts",
      "import": "./src/subscription-math.ts",
      "require": "./dist/subscription-math.js"
    },
    "./security": {
      "types": "./src/security.ts",
      "import": "./src/security.ts",
      "require": "./dist/security.js"
    },
    "./crypto": {
      "types": "./src/crypto/index.ts",
      "import": "./src/crypto/index.ts",
      "require": "./dist/crypto/index.js"
    },
    "./crypto/runtime": {
      "types": "./src/crypto/runtime/types.ts",
      "browser": "./src/crypto/runtime/browser.ts",
      "node": "./src/crypto/runtime/node.ts",
      "import": "./src/crypto/runtime/node.ts",
      "require": "./dist/crypto/runtime/node.js",
      "default": "./src/crypto/runtime/node.ts"
    },
    "./crypto/runtime/node": {
      "types": "./src/crypto/runtime/types.ts",
      "import": "./src/crypto/runtime/node.ts",
      "require": "./dist/crypto/runtime/node.js"
    },
    "./crypto/runtime/browser": {
      "types": "./src/crypto/runtime/types.ts",
      "import": "./src/crypto/runtime/browser.ts",
      "require": "./dist/crypto/runtime/browser.js"
    },
    "./stellar/memo": {
      "types": "./src/stellar/memo.ts",
      "import": "./src/stellar/memo.ts",
      "require": "./dist/stellar/memo.js"
    }
  },
  "browser": {
    "./src/crypto/runtime/node.ts": "./src/crypto/runtime/browser.ts",
    "./dist/crypto/runtime/node.js": "./dist/crypto/runtime/browser.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test": "jest && jest --config jest.browser.config.js"
  },
  "keywords": ["syncro", "types", "domain-models", "crypto"],
  "license": "ISC",
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
