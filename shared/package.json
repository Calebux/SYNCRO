{
  "name": "@syncro/shared",
  "version": "1.0.0",
  "description": "Shared domain models and types for SYNCRO",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "subscription-math": ["src/subscription-math.ts"],
      "security": ["src/security.ts"],
      "crypto": ["src/crypto/index.ts"],
      "generated": ["src/generated/index.ts"],
      "domain": ["src/domain/index.ts"],
      "*": ["src/*"]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "import": "./src/generated/index.ts",
      "require": "./dist/generated/index.js"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "import": "./src/domain/index.ts",
      "require": "./dist/domain/index.js"
    },
    "./subscription-math": {
      "types": "./src/subscription-math.ts",
      "import": "./src/subscription-math.ts",
      "require": "./dist/subscription-math.js"
    },
    "./security": {
      "types": "./src/security.ts",
      "import": "./src/security.ts",
      "require": "./dist/security.js"
    },
    "./crypto": {
      "types": "./src/crypto/index.ts",
      "import": "./src/crypto/index.ts",
      "require": "./dist/crypto/index.js"
    },
    "./stellar/memo": {
      "types": "./src/stellar/memo.ts",
      "import": "./src/stellar/memo.ts",
      "require": "./dist/stellar/memo.js"
    }
  },
  "scripts": {
    "generate:db": "node ../scripts/generate-db-types.mjs",
    "generate:contracts": "node ../scripts/generate-contract-types.mjs",
    "generate": "npm run generate:db && npm run generate:contracts",
    "check:generated": "node ../scripts/check-generated-types.mjs",
    "prebuild": "npm run generate",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test": "jest",
    "prepublishOnly": "node ../scripts/assert-ci-publish.mjs && npm run build"
  },
  "keywords": ["syncro", "types", "domain-models", "crypto"],
  "license": "ISC",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
