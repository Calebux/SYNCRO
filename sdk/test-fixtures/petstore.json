{
  "openapi": "3.1.0",
  "info": {
    "title": "Petstore API",
    "version": "1.0.0",
    "description": "A sample Pet Store API for testing OpenAPI import"
  },
  "paths": {
    "/pets": {
      "get": {
        "summary": "List all pets",
        "operationId": "listPets",
        "description": "Returns a list of all pets in the store",
        "responses": {
          "200": {
            "description": "A list of pets"
          }
        }
      },
      "post": {
        "summary": "Create a pet",
        "operationId": "createPet",
        "x-syncro-price": 0.05,
        "description": "Add a new pet to the store",
        "responses": {
          "201": {
            "description": "Pet created"
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Get a pet by ID",
        "operationId": "getPet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pet details"
          },
          "404": {
            "description": "Pet not found"
          }
        }
      },
      "put": {
        "summary": "Update a pet",
        "operationId": "updatePet",
        "x-syncro-price": 0.03,
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pet updated"
          }
        }
      },
      "delete": {
        "summary": "Delete a pet",
        "operationId": "deletePet",
        "description": "Remove a pet from the store",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Pet deleted"
          }
        }
      }
    },
    "/pets/{petId}/photos": {
      "get": {
        "summary": "Get pet photos",
        "operationId": "getPetPhotos",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of photo URLs"
          }
        }
      }
    }
  }
}
