{
  "name": "@handsoff/metering",
  "version": "0.1.0",
  "private": true,
  "description": "Metering: reserve/commit durable path for paid calls",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "load": "tsx load/run.ts",
    "load:budget": "tsx load/run.ts --budget --report load/budget.json",
    "load:ci": "tsx load/run.ts --budget --report load/budget.json --ci"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
