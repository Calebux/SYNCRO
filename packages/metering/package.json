{
  "name": "@handsoff/metering",
  "version": "0.1.0",
  "private": true,
  "description": "Metering core: reserve/commit/release/read interface with degraded-mode built in",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "load": "tsx load/run.ts",
    "load:budget": "tsx load/run.ts --budget --report load/budget.json",
    "load:ci": "tsx load/run.ts --budget --report load/budget.json --ci"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
