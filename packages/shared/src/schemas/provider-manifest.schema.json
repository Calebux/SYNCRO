{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syncro.dev/schemas/provider-manifest/v1.json",
  "title": "SyncroProviderManifest",
  "description": "Machine-readable advertisement of a SYNCRO API provider. An agent visiting a new provider endpoint fetches this manifest to discover accepted payment assets, per-route prices, and receipt-signing public keys before making any paid call.",
  "type": "object",
  "required": ["manifestVersion","providerId","gatewayUrl","mode","acceptedAssets","routes","receiptKeys","termsUrl","generatedAt"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "providerId": { "type": "string", "format": "uuid" },
    "identity": { "type": "string", "minLength": 1 },
    "gatewayUrl": { "type": "string", "format": "uri" },
    "mode": { "type": "string", "enum": ["staging", "production"] },
    "acceptedAssets": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/AssetDescriptor" } },
    "routes": { "type": "array", "items": { "$ref": "#/definitions/RouteDescriptor" } },
    "receiptKeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ReceiptKeyEntry" } },
    "termsUrl": { "type": "string", "format": "uri" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "AssetDescriptor": {
      "type": "object",
      "required": ["asset","network","scheme"],
      "additionalProperties": false,
      "properties": {
        "asset": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "minLength": 1 },
        "contract": { "type": "string" }
      }
    },
    "RouteDescriptor": {
      "type": "object",
      "required": ["routeId","pathPattern","method","unit","priceStroops","maxBillableUnits"],
      "additionalProperties": false,
      "properties": {
        "routeId": { "type": "string", "format": "uuid" },
        "pathPattern": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "enum": ["call","token","byte","second"] },
        "priceStroops": { "type": "integer", "minimum": 1 },
        "maxBillableUnits": { "type": "integer", "minimum": 1 },
        "rateCardVersion": { "type": "string", "minLength": 1 },
        "effectiveFrom": { "type": "string", "format": "date-time" }
      }
    },
    "ReceiptKeyEntry": {
      "type": "object",
      "required": ["keyId","status","publicKeyPem"],
      "additionalProperties": false,
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["current","previous"] },
        "publicKeyPem": { "type": "string", "minLength": 1 },
        "rotatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
