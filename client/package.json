{
  "name": "@syncro/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/validate-env.js",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "lint": "eslint .",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "vitest run -c vitest.storybook.config.ts --project storybook",
    "test:flaky": "tsx scripts/generate-flaky-dashboard.ts",
    "test:flaky-report": "npm run test:flaky && open test-results/flaky-dashboard.html",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate-env": "node scripts/validate-env.js",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.js",
    "generate-pwa-screenshot": "node scripts/generate-pwa-screenshot.js",
    "generate-pwa-assets": "npm run generate-pwa-icons && npm run generate-pwa-screenshot",
    "postbuild": "node scripts/check-bundle-size.js --write-report=.next/route-bundle-report.json --no-fail",
    "check-bundle-size": "node scripts/check-bundle-size.js",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:report": "npx playwright show-report",
    "e2e:flaky": "npx playwright test && cat test-results/flaky-tests.md",
    "test:a11y": "npx playwright test e2e/accessibility.spec.ts",
    "lint:deps": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.devDependencies}).filter(([,v])=>v==='latest'||v==='*'||/^\\^?\\d+$/.test(v)).map(([n,v])=>n+'@'+v);if(bad.length){console.error('Loose dep ranges:',bad);process.exit(1);}else{console.log('All dep ranges OK');}\"",
    "preinstall": "npm run lint:deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
